{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "ImpactEdge",
  "description": "If A changes, B is affected -- and WHY. `reason` is required: a bare list of affected files persuades nobody and cannot be checked.",
  "required": [
    "schema_version",
    "from_node",
    "to_node",
    "edge_type",
    "reason",
    "evidence",
    "confidence_basis"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$",
      "description": "Contract version. P8 detects a stale record by comparing this."
    },
    "from_node": {
      "type": "string",
      "minLength": 1
    },
    "to_node": {
      "type": "string",
      "minLength": 1
    },
    "edge_type": {
      "type": "string",
      "minLength": 1
    },
    "distance": {
      "enum": [
        "DIRECT",
        "INDIRECT"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "Evidence.json"
      }
    },
    "confidence_basis": {
      "enum": [
        "deterministic",
        "model_inference",
        "human_confirmed"
      ]
    }
  },
  "$id": "ImpactEdge.json"
}
