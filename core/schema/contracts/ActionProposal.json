{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "ActionProposal",
  "description": "One proposed change. `necessity` is the field that makes the unnecessary-change metric measurable: if everything is required, the system is inventing work.",
  "required": [
    "schema_version",
    "kind",
    "target",
    "diff",
    "rationale",
    "evidence",
    "necessity"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$",
      "description": "Contract version. P8 detects a stale record by comparing this."
    },
    "kind": {
      "enum": [
        "code",
        "documentation",
        "workflow",
        "data",
        "test",
        "communication",
        "training"
      ]
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "diff": {
      "type": "string"
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "Evidence.json"
      }
    },
    "necessity": {
      "enum": [
        "required",
        "recommended",
        "optional",
        "unsupported"
      ]
    },
    "artifact_family": {
      "enum": [
        "software",
        "workflow",
        "docs",
        "spreadsheet",
        "tests",
        "history"
      ]
    }
  },
  "$id": "ActionProposal.json"
}
