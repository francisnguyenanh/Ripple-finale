{
  "note": "Distractor rules for the QRY-02 retrieval evaluation. They have nothing to do with approval authority except by shared words (purchase, approval, review, Finance). Written before any retrieval method beyond term frequency was measured.",
  "rules": [
    {
      "rule_id": "rule-free-freight",
      "concept_ids": [
        "concept-freight"
      ],
      "title": "Purchases of 500,000 JPY or more receive free freight delivery",
      "condition": {
        "field": "order.net_goods_jpy",
        "op": "gte",
        "value": 500000,
        "unit": "JPY"
      },
      "actor_ref": "role-logistics",
      "outcome": {
        "kind": "free_shipping"
      },
      "exceptions": [],
      "scope": {
        "process": [
          "STANDARD"
        ]
      },
      "status": "VALIDATED",
      "authority": "OBSERVED",
      "provenance": [
        {
          "kind": "source_evidence",
          "artifact_id": "doc-other",
          "revision_id": "rev-1",
          "evidence_ref": "other.md#rule-free-freight"
        }
      ],
      "source_bindings": [
        {
          "artifact_id": "doc-other",
          "revision_id": "rev-1",
          "evidence_ref": "other.md#rule-free-freight"
        }
      ],
      "implementation_status": "not_required"
    },
    {
      "rule_id": "rule-shipping-fee",
      "concept_ids": [
        "concept-freight"
      ],
