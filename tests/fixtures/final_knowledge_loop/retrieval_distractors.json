    {
      "rule_id": "rule-price-tolerance",
      "concept_ids": [
        "concept-invoice-matching"
      ],
      "title": "Invoice price may differ from the purchase order by 10,000 JPY or 2 percent",
      "condition": {
        "field": "invoice.price_difference_jpy",
        "op": "lte",
        "value": 10000,
        "unit": "JPY"
      },
      "actor_ref": "role-accounts-payable",
